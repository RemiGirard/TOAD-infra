# =============================================================================
# TOAD-infra .gitignore
# =============================================================================

# -- Secrets & Credentials --
# Never commit credentials, keys, passwords, tokens
**/credentials/*
!**/credentials/.gitkeep
**/secrets/*.plain
**/secrets/*.txt
backups/
*.pem
*.key
!*.key.pub
**/.env
**/.env.*
!**/.env.example
router/config.yaml

# -- Python --
venv/
.venv/
openstack_cli/
__pycache__/
*.py[cod]
*.egg-info/

# -- Node --
node_modules/
dist/
*.js
*.js.map
npm-debug.log*

# -- IDE --
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# -- Claude / AI --
.claude/

# -- Generated files --
**/inventory.yaml
!**/inventory.example.yaml
openstackV3/contexts/
openstackV3/.toad-context
openstackV3/pki/
**/.operation.lock

# -- Logs & Temp --
*.log
*.bak
*.tmp
*.temp

# -- Old versions (removed from tracking, kept locally) --
openstack/
openstackV2/
